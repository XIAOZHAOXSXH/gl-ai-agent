#!/bin/sh
# GL-AI助手 post-remove: leave no trace in the stock admin UI.
#
# Removal strips only our own <script> tag rather than restoring a whole-file
# backup. That is deliberate: other plugins (glinjector and friends) inject
# their own tags into the same page, and overwriting the file would silently
# undo their work. A surgical removal restores the page to exactly the state
# it had before we were installed, even in a crowded page.
#
# User data (config, sessions) survives by default; pass purge or KEEP_DATA=purge to remove it.
set -e

# During an opkg/apk upgrade the old package's postrm is called with
# "upgrade" after the new payload is already installed. Never remove shared
# paths in that phase or the fresh package disappears.
case "${1:-remove}" in
    upgrade|abort-upgrade) exit 0 ;;
esac

PKG=gl-ai-agent
ETCDIR=/etc/$PKG
GLHOME=/www/gl_home.html

# ---- remove only our tag -------------------------------------------------
if [ -f "$GLHOME" ]; then
    sed -i "s#<script src=\"/js/$PKG-boot.js\"></script>##g" "$GLHOME"
fi

# ---- drop generated assets ----------------------------------------------
rm -f /www/views/gl-sdk4-ui-gl-ai.common.js
rm -f /www/views/gl-sdk4-ui-gl-ai.common.js.gz
rm -f /www/js/$PKG-boot.js
rm -f /usr/share/oui/menu.d/gl-ai.json
rm -f /www/i18n/gl-sdk4-ui-gl-ai.*.json
rm -f /usr/lib/oui-httpd/rpc/gl_ai
rm -f /usr/share/gl-validator.d/gl_ai.lua
rm -f /etc/nginx/gl-conf.d/$PKG.conf
rm -f /etc/nginx/conf.d/$PKG-main.conf

# the pristine copy is only useful while installed
rm -f "$ETCDIR/gl_home.html.orig"

# ---- user data ----------------------------------------------------------
if [ "$1" = "purge" ] || [ "$KEEP_DATA" = "purge" ]; then
    rm -rf "$ETCDIR"
fi

if [ -x /etc/init.d/nginx ]; then
    nginx -t >/dev/null 2>&1 && /etc/init.d/nginx reload >/dev/null 2>&1 || true
fi

exit 0
