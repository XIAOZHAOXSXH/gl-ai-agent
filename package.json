{
  "name": "gl-ai-agent",
  "private": true,
  "version": "0.1.0",
  "description": "GL-AI assistant: a natural-language router configuration agent embedded in the native GL.iNet SDK4 admin UI.",
  "license": "MIT",
  "scripts": {
    "build:ui": "node scripts/build-ui.js",
    "build:ipk": "node scripts/build-ipk.js",
    "build:apk": "node scripts/build-apk.js",
    "build": "npm run build:ui && npm run build:ipk && npm run build:apk",
    "check:bundle": "node scripts/check-bundle.js",
    "check:contract": "node scripts/check-eval-contract.js",
    "check:package": "node scripts/check-package.js dist/gl-ai-agent_0.1.0_all.ipk dist/gl-ai-agent-0.1.0-r1.apk",
    "verify:core": "node scripts/verify-core.js",
    "verify:ui": "node scripts/verify-ui.js",
    "test:install": "node scripts/test-install.js",
    "deploy": "node scripts/deploy.js",
    "deploy:uninstall": "node scripts/deploy.js --uninstall"
  },
  "devDependencies": {
    "css-loader": "^6.11.0",
    "playwright": "^1.63.0",
    "vue-loader": "^15.11.1",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "2.6.12",
    "webpack": "^5.97.1"
  }
}
